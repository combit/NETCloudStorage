<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>combit.Reporting.CloudStorage.Dropbox</RootNamespace>
    <AssemblyName>combit.ListLabel32.CloudStorage.Dropbox</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <UseWpf>true</UseWpf>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release_NET11</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants)TRACE;NET_BUILD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_NET11|AnyCPU'">
    <DefineConstants>$(DefineConstants)TRACE;NET_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\combit.ListLabel.CloudStorage.Dropbox\Dropbox.cs" Link="Dropbox.cs" />
    <Compile Include="..\..\combit.ListLabel.CloudStorage.Dropbox\LoginForm.xaml.cs" Link="LoginForm.xaml.cs" />
    <Compile Include="..\..\common\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="combit.ListLabel32" Version="32.0.0" />
    <PackageReference Include="Dropbox.Api" Version="7.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\..\combit.ListLabel.CloudStorage.Dropbox\LoginForm.xaml" Link="LoginForm.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
</Project>